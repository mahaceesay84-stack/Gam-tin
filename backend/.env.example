# Copy to backend/.env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL). Set DB_ENGINE=sqlite only for quick local experiments/tests.
DB_ENGINE=postgres
DB_NAME=utg_clearance
DB_USER=utg_clearance
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (minutes / days)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# File storage (local media/ by default; swap the dotted path for a cloud backend later)
MEDIA_ROOT=media
DOCUMENT_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# Seed data passwords (used by `manage.py seed_data`)
SEED_ADMIN_PASSWORD=change-me-admin
SEED_STUDENT_PASSWORD=change-me-student

# Email. Default writes each message to a file under EMAIL_FILE_PATH (no network).
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=media/emails
DEFAULT_FROM_EMAIL=no-reply@utg-dss-prototype.local
# SMTP example (only used when EMAIL_BACKEND is the smtp backend):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
